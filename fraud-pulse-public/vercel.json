{
  "version": 2,
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/features",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/features/",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/blog/biggest-mistake-after-chargeback-spike",
      "destination": "/blog/stripe-account-review-after-chargebacks/",
      "permanent": true
    },
    {
      "source": "/blog/biggest-mistake-after-chargeback-spike/",
      "destination": "/blog/stripe-account-review-after-chargebacks/",
      "permanent": true
    },
    {
      "source": "/blog/biggest-revenue-leak-might-be-false-positives",
      "destination": "/blog/hidden-cost-of-false-positives-in-fraud-systems/",
      "permanent": true
    },
    {
      "source": "/blog/biggest-revenue-leak-might-be-false-positives/",
      "destination": "/blog/hidden-cost-of-false-positives-in-fraud-systems/",
      "permanent": true
    },
    {
      "source": "/blog/fraud-system-might-be-your-biggest-revenue-leak",
      "destination": "/blog/hidden-cost-of-false-positives-in-fraud-systems/",
      "permanent": true
    },
    {
      "source": "/blog/fraud-system-might-be-your-biggest-revenue-leak/",
      "destination": "/blog/hidden-cost-of-false-positives-in-fraud-systems/",
      "permanent": true
    },
    { "source": "/faqs", "destination": "/faq/", "statusCode": 301 },
    { "source": "/faqs/", "destination": "/faq/", "statusCode": 301 },
    { "source": "/support", "destination": "/faq/", "statusCode": 301 },
    { "source": "/support/", "destination": "/faq/", "statusCode": 301 },
    { "source": "/compare/nofraud", "destination": "/alternatives/nofraud/", "statusCode": 301 },
    { "source": "/compare/nofraud/", "destination": "/alternatives/nofraud/", "statusCode": 301 },
    {
      "source": "/blog/fraudpulse-does-not-replace-stripe-radar-shopify-protect",
      "destination": "/blog/fraudpulse-does-not-replace-stripe-radar-shopify-flow/",
      "statusCode": 301
    },
    {
      "source": "/blog/fraudpulse-does-not-replace-stripe-radar-shopify-protect/",
      "destination": "/blog/fraudpulse-does-not-replace-stripe-radar-shopify-flow/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fraud-pulse.com" }],
      "destination": "https://www.fraud-pulse.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/og-image.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/pricing.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/pricing.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.fraud-pulse.com/llms.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"llms.txt\""
        }
      ]
    }
  ]
}
