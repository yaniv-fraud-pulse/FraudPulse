{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      { "source": "/faqs{,/**}", "destination": "/faq/", "type": 301 },
      { "source": "/support{,/**}", "destination": "/faq/", "type": 301 },
      { "source": "/compare/nofraud{,/**}", "destination": "/alternatives/nofraud/", "type": 301 },
      {
        "source": "/blog/fraudpulse-does-not-replace-stripe-radar-shopify-protect{,/**}",
        "destination": "/blog/fraudpulse-does-not-replace-stripe-radar-shopify-flow/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|woff|woff2|ttf|eot)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  }
}
